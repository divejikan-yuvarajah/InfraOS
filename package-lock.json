{
  "name": "infraos",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "infraos",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "workspaces": [
        "apps/web",
        "apps/api",
        "packages/*"
      ],
      "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
      }
    },
    "apps/api": {
      "name": "@infraos/api",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@infraos/web",
      "version": "0.0.0"
    },
    "node_modules/@infraos/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@infraos/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@infraos/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared-types": {
      "name": "@infraos/shared-types",
      "version": "0.0.0"
    }
  }
}
