# Local API config — copy to `.env` to override.
# Names and non-secret local defaults only. Never put real secrets here.
# Canonical names: docs/setup/environment.md
# Rejected aliases: JWT_SECRET, REFRESH_SECRET, CLIENT_URL, AI_SERVICE_SECRET, AI_SERVICE_URL

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info
API_PREFIX=/api/v1

# MongoDB (Atlas): required to connect. Empty URI: HTTP still starts; /ready is 503.
# Use a dev-only database user; URL-encode special characters in the password.
MONGODB_URI=
MONGODB_DB_NAME=infraos_dev

# Authentication: required for login. Use two DIFFERENT random secrets, at least 32 characters.
# Generate each locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# Optional: set only when the AI service / RAG is actually used.
AI_BASE_URL=
AI_INTERNAL_SECRET=
AI_INTERNAL_SECRET_PREVIOUS=
# AI Models: unset by default; must be live-probed (fails closed with "not configured")
AI_CHAT_MODEL=
AI_CHAT_MODEL_STRONG=
AI_VISION_MODEL=
AI_COPILOT_TTL_DAYS=30
AI_VISION_MAX_BYTES=6291456
OPENROUTER_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# Optional: set only when object storage (file uploads) is used.
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Email & Admin Approval Notifications
ADMIN_APPROVAL_EMAIL=divejuthe23@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InfraOS Platform <notifications@infraos.gov.lk>"
SMTP_SECURE=false

# Optional: Risk scheduler tuning (defaults: enabled=true, 02:00 Asia/Colombo, max 2000 projects/run)
RISK_SCHEDULE_ENABLED=true
RISK_SCHEDULE_HOUR=2
RISK_MAX_PROJECTS_PER_RUN=2000

