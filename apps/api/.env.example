# Local API config — copy to `.env` to override.
# Names and non-secret local defaults only. Never put real secrets here.
# Canonical names: docs/setup/environment.md
# Rejected aliases: JWT_SECRET, REFRESH_SECRET, CLIENT_URL, AI_SERVICE_SECRET, AI_SERVICE_URL

NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info
API_PREFIX=/api/v1

# Required from Step 11 to connect. Empty URI: HTTP still starts; /ready is 503.
MONGODB_URI=
MONGODB_DB_NAME=infraos_dev

# Required when authentication is implemented. Leave empty for now.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# Required when the AI service is implemented.
AI_BASE_URL=
AI_INTERNAL_SECRET=
OPENROUTER_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# Required when object storage is implemented.
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
