{
  "name": "@infraos/api",
  "version": "0.1.0",
  "private": true,
  "description": "INFRAOS Express API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
