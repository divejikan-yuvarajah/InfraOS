    "start": "tsx src/server.ts",
    "start:dist": "node dist/server.js",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:indexes:check": "tsx src/scripts/check-indexes.ts",
    "db:seed:core": "tsx src/scripts/seed-core.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:seed:verify": "tsx src/scripts/verify-demo-seed.ts",
    "db:import:hazards": "tsx src/scripts/import-hazard-zones.ts",
    "db:sync:finance-permissions": "tsx src/scripts/sync-finance-permissions.ts",
    "db:sync:inspection-permissions": "tsx src/scripts/sync-inspection-permissions.ts",
    "db:sync:asset-permissions": "tsx src/scripts/sync-asset-permissions.ts",
    "db:sync:document-permissions": "tsx src/scripts/sync-document-permissions.ts",
    "db:sync:risk-permissions": "tsx src/scripts/sync-risk-permissions.ts",
    "risk:migrate": "tsx src/scripts/migrate-risk-batch11.ts",
    "risk:smoke": "tsx src/scripts/risk-smoke.ts",
    "risk:demo-sequence": "tsx src/scripts/risk-demo-sequence.ts",
    "db:backfill:finance": "tsx src/scripts/backfill-finance-batch05.ts",
    "db:backfill:inspections": "tsx src/scripts/backfill-inspections-batch06.ts",
    "db:backfill:assets": "tsx src/scripts/backfill-assets-batch07.ts",
    "db:backfill:documents": "tsx src/scripts/backfill-documents-batch08.ts",
    "db:migrate:document-chunks": "tsx src/scripts/migrate-document-chunks-batch09.ts",
    "ai:smoke": "tsx src/scripts/ai-smoke.ts",
    "ai:calibrate-retrieval": "tsx src/scripts/ai-calibrate.ts",
    "ai:demo-ask": "tsx src/scripts/ai-demo-ask.ts",
    "ai:demo-process": "tsx src/scripts/ai-demo-process.ts",
    "db:cleanup:documents": "tsx src/scripts/cleanup-orphan-uploads.ts",
    "db:recompute:asset-health": "tsx src/scripts/recompute-asset-health.ts",
    "db:cleanup:evidence": "tsx src/scripts/cleanup-evidence.ts",
    "db:backfill:contractors": "tsx src/scripts/backfill-contractors-batch04.ts",
    "db:seed:reset-demo": "tsx src/scripts/reset-demo-seed.ts",
    "db:set-password": "tsx src/scripts/set-user-password.ts",
