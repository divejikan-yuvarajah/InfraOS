{
  "name": "@infraos/api",
  "version": "0.1.0",
  "private": true,
  "description": "INFRAOS Express API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:indexes:check": "tsx src/scripts/check-indexes.ts",
    "db:seed:core": "tsx src/scripts/seed-core.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:seed:verify": "tsx src/scripts/verify-demo-seed.ts",
    "db:seed:reset-demo": "tsx src/scripts/reset-demo-seed.ts",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@infraos/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "6.2.13",
    "mongoose": "^8.24.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
