    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.3.0",
