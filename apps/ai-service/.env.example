# Copy to `.env` (gitignored). Names only — no secrets here, ever.
# Express is the only caller. The browser must never receive these values.

APP_ENV=development
PORT=8000

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_EMBED_MODEL=baai/bge-m3
# AI Models: unset by default; must be live-probed (fails closed with "not configured")
AI_CHAT_MODEL=
AI_CHAT_MODEL_STRONG=
AI_VISION_MODEL=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Must equal AI_INTERNAL_SECRET in apps/api/.env (generate: 48+ random bytes, base64url).
AI_INTERNAL_SECRET=
# Optional second secret for zero-downtime rotation:
AI_INTERNAL_SECRET_PREVIOUS=
