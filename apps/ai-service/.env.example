# Copy to `.env` (gitignored). Names only — no secrets here, ever.
# Express is the only caller. The browser must never receive these values.

APP_ENV=development
PORT=8000

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
AI_EMBED_MODEL=baai/bge-m3

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Must equal AI_INTERNAL_SECRET in apps/api/.env (generate: 48+ random bytes, base64url).
AI_INTERNAL_SECRET=
