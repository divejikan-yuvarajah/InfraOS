# Copy to `.env.local` for local development. Names only — no secrets.
# NEXT_PUBLIC_* is visible in the browser. Never put Mongo, JWT, AI, or R2 secrets here.
# Canonical catalog: docs/setup/environment.md
#
# API origin only (no /api/v1 suffix). Paths passed to apiClient include the prefix.
# Login is OFF by default. Enabling production live mode requires an HTTPS API
# origin, verified cookies/CORS, release approval, and rebuilding the Next app.
# Do not enable this solely to work around a missing backend.

# For local development with a running API, set NEXT_PUBLIC_AUTH_LOGIN_ENABLED=1 in your own
# apps/web/.env.local. The API's FRONTEND_ORIGIN must match this app's origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_LOGIN_ENABLED=0
NEXT_PUBLIC_MAP_STYLE_URL=

# Testing only: fixture authentication. Keep 0 for normal development.
NEXT_PUBLIC_AUTH_FIXTURE=0
