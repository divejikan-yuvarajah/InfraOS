# Copy to `.env.local` for local development. Names only — no secrets.
# NEXT_PUBLIC_* is visible in the browser. Never put Mongo, JWT, AI, or R2 secrets here.
# Canonical catalog: docs/setup/environment.md
#
# API origin only (no /api/v1 suffix). Paths passed to apiClient include the prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=
