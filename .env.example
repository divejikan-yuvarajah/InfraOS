# INFRAOS environment index — names only.
# Canonical catalog: docs/setup/environment.md (Step 10, INC-005 closed).
#
# Copy the per-app example. Do not maintain secrets in this file.
#   apps/web/.env.example        → apps/web/.env.local
#   apps/api/.env.example        → apps/api/.env
#   apps/ai-service/.env.example → apps/ai-service/.env (AI step)
#
# Public (browser): NEXT_PUBLIC_API_BASE_URL, NEXT_PUBLIC_MAP_STYLE_URL,
#                   NEXT_PUBLIC_AUTH_LOGIN_ENABLED, NEXT_PUBLIC_AUTH_FIXTURE
# Private (API):    NODE_ENV, PORT, FRONTEND_ORIGIN, LOG_LEVEL, API_PREFIX,
#                   MONGODB_URI, MONGODB_DB_NAME,
#                   ACCESS_TOKEN_SECRET, ACCESS_TOKEN_TTL,
#                   REFRESH_TOKEN_SECRET, REFRESH_TOKEN_TTL,
#                   AI_BASE_URL, AI_INTERNAL_SECRET, OPENROUTER_API_KEY,
#                   QDRANT_URL, QDRANT_API_KEY,
#                   STORAGE_PROVIDER, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
#                   R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_ENDPOINT
#
# Do not use JWT_SECRET, REFRESH_SECRET, CLIENT_URL, AI_SERVICE_SECRET, or AI_SERVICE_URL.
# Never put real secrets, keys, or connection strings in example files.

NODE_ENV=
PORT=
FRONTEND_ORIGIN=
LOG_LEVEL=
API_PREFIX=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_AUTH_LOGIN_ENABLED=
NEXT_PUBLIC_AUTH_FIXTURE=
MONGODB_URI=
MONGODB_DB_NAME=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=
AI_BASE_URL=
AI_INTERNAL_SECRET=
AI_INTERNAL_SECRET_PREVIOUS=
# AI Models: unset placeholders by default; leave empty until live-probed on OpenRouter (fails closed with MODEL_NOT_CONFIGURED)
AI_CHAT_MODEL=
AI_CHAT_MODEL_STRONG=
AI_VISION_MODEL=
AI_COPILOT_TTL_DAYS=30
AI_VISION_MAX_BYTES=6291456
OPENROUTER_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
ADMIN_APPROVAL_EMAIL=divejuthe23@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="InfraOS Platform <notifications@infraos.gov.lk>"
SMTP_SECURE=false
